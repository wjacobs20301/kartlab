diff --git a/src/mc_Float.cpp b/src/mc_Float.cpp
index 7c8708d..1ee56c1 100644
--- a/src/mc_Float.cpp
+++ b/src/mc_Float.cpp
@@ -2,7 +2,7 @@
 
 #ifdef _MSC_VER
 #include <intrin.h>
-#elif defined(__GNUC__)
+#elif defined(__GNUC__) && defined(__x86_64__)
 #include <xmmintrin.h>
 #endif
 
@@ -14,7 +14,7 @@ u32 InitFPUState() {
 #else
 #if defined(__clang__) || !defined(__GNUC__)  
     u32 csr;
-    __asm__("mrs %0, fpcr" : "=r"(csr));
+    __asm__("mrs %x0, fpcr" : "=r"(csr));
 #else
     // only gcc appears to have an intrinsic for this
     u32 csr = __builtin_aarch64_get_fpcr();
@@ -33,7 +33,7 @@ u32 InitFPUState() {
     _mm_setcsr(newCsr);
 #else
 #if defined(__clang__) || !defined(__GNUC__)
-    __asm__("msr fpcr, %0" :: "r"(newCsr));
+    __asm__("msr fpcr, %x0" :: "r"(newCsr));
 #else
     __builtin_aarch64_set_fpcr(newCsr);
 #endif
@@ -46,7 +46,7 @@ void SetFPUState(u32 state) {
     _mm_setcsr(state);
 #else
 #if defined(__clang__) || !defined(__GNUC__)
-    __asm__("msr fpcr, %0" :: "r"(state));
+    __asm__("msr fpcr, %x0" :: "r"(state));
 #else
     __builtin_aarch64_set_fpcr(state);
 #endif
